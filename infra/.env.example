# infra/.env로 복사해서 쓴다(.env는 git에 올리지 않는다). 로컬 개발용 값이다.
POSTGRES_DB=storesearch
POSTGRES_USER=storesearch
# 로컬 전용 비밀번호. 아무 값이나 정해서 넣는다(서버 비밀번호와 같게 쓰지 않는다)
POSTGRES_PASSWORD=
DB_PORT=5432
DB_SHARED_BUFFERS=2GB

# 임베딩 서버(--profile ai)
EMBED_MODEL_NAME=bge_m3_ft_mj_20261014_0743
# 모델 폴더 위치(infra 폴더 기준 상대 경로 또는 절대 경로)
EMBED_MODEL_DIR=../models/bge_m3_ft_mj_20261014_0743
EMBED_PORT=8001
EMBED_THREADS=4
